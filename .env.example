# LLM Provider: "ollama" (free, local) or "openai" (paid, cloud)
LLM_PROVIDER=ollama

# Ollama settings (default - works out of the box)
OLLAMA_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.1:8b

# OpenAI settings (only needed if LLM_PROVIDER=openai)
# OPENAI_API_KEY=sk-your-key-here
# LLM_MODEL=gpt-4o-mini

# App settings
APP_HOST=0.0.0.0
APP_PORT=8000
REQUIRE_HUMAN_APPROVAL=true
LOG_LEVEL=INFO

# GitHub integration (optional - for repo/PR analysis)
# Get a token at https://github.com/settings/tokens
# GITHUB_TOKEN=ghp_your-token-here
# GITHUB_WEBHOOK_SECRET=your-webhook-secret
# Webhook URL: http://your-server:8000/api/github/webhook

# Rate limiting
RATE_LIMIT_PER_MINUTE=10
